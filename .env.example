APP_NAME="Scrapify Auction API"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.scrapifyauctions.com

VENDOR_REGISTRATION_FEE=5000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=scrapify_api
DB_USERNAME=scrapify_user
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# MSG91 OTP — keep the real auth key in the deployment secret store or admin settings.
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=
MSG91_SMS_TEMPLATE_ID=
MSG91_SENDER_ID=
MSG91_COUNTRY_CODE=91
OTP_TEST_MODE=false

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINTS=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_TTL=60

CORS_ALLOWED_ORIGINS=*

# Firebase Auth project used to verify web Google ID tokens.
FIREBASE_PROJECT_ID=scrapify-auction

# Cashfree Secure ID — sandbox only until production approval is explicit.
CASHFREE_SECURE_ID_ENABLED=false
CASHFREE_SECURE_ID_ENV=sandbox
CASHFREE_SECURE_ID_CLIENT_ID=
CASHFREE_SECURE_ID_CLIENT_SECRET=
CASHFREE_SECURE_ID_BASE_URL=https://sandbox.cashfree.com/verification
CASHFREE_SECURE_ID_TIMEOUT=30
